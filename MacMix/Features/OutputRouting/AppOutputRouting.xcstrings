{
  "sourceLanguage": "en",
  "strings": {
    "AirPlay uses the receivers connected in the system output selector.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم AirPlay أجهزة الاستقبال المتصلة في محدد الإخراج الخاص بالنظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay verwendet die im Systemausgabe-Menü verbundenen Empfänger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay usa los receptores conectados en el selector de salida del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay utilise les récepteurs connectés dans le sélecteur de sortie du système."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay सिस्टम आउटपुट चयनकर्ता में कनेक्ट किए गए रिसीवर का उपयोग करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay menggunakan penerima yang terhubung di pemilih output sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay usa i ricevitori collegati nel selettore di uscita del sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlayはシステムの出力選択で接続されているレシーバーを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay는 시스템 출력 선택기에서 연결된 수신기를 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay gebruikt de ontvangers die zijn verbonden in de uitvoerkiezer van het systeem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay używa odbiorników połączonych w systemowym wyborze wyjścia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AirPlay usa os receptores conectados no seletor de saída do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay использует приёмники, подключённые в системном выборе выхода."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay ใช้ตัวรับที่เชื่อมต่อในตัวเลือกเอาต์พุตของระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay, sistem çıkış seçicisinde bağlı alıcıları kullanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay dùng các bộ thu đã kết nối trong bộ chọn đầu ra của hệ thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 使用系统输出选择器中已连接的接收设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 使用系統輸出選擇器中已連接的接收裝置。"
          }
        }
      }
    },
