    "Could not start the selected outputs. Check the devices and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر بدء الإخراج المحدد. تحقق من الأجهزة وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Ausgaben konnten nicht gestartet werden. Prüfe die Geräte und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron iniciar las salidas seleccionadas. Comprueba los dispositivos e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer les sorties sélectionnées. Vérifiez les appareils et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयनित आउटपुट शुरू नहीं किए जा सके। डिवाइस जाँचें और फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memulai output yang dipilih. Periksa perangkat lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare le uscite selezionate. Controlla i dispositivi e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した出力を開始できませんでした。デバイスを確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 출력을 시작할 수 없습니다. 기기를 확인한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de geselecteerde uitvoer niet starten. Controleer de apparaten en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można uruchomić wybranych wyjść. Sprawdź urządzenia i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar as saídas selecionadas. Verifique os dispositivos e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить выбранные выходы. Проверьте устройства и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเริ่มเอาต์พุตที่เลือกได้ ตรวจสอบอุปกรณ์แล้วลองอีกครั้ง"
