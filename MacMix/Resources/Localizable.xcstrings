    "1–9 activate scenes in order. 0 turns scenes off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفعّل الأرقام 1–9 المشاهد بالترتيب. يعطّل 0 المشاهد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–9 aktivieren Szenen der Reihe nach. 0 deaktiviert Szenen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–9 activate scenes in order. 0 turns scenes off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–9 activan escenas en orden. 0 desactiva las escenas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–9 activent les scènes dans l’ordre. 0 désactive les scènes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–9 क्रम से दृश्य चालू करते हैं। 0 दृश्य बंद करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–9 mengaktifkan adegan secara berurutan. 0 menonaktifkan adegan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–9 attivano le scene in ordine. 0 disattiva le scene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1〜9で順番にシーンを有効にし、0でシーンをオフにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–9는 순서대로 장면을 켜고, 0은 장면을 끕니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–9 activeren scènes op volgorde. 0 schakelt scènes uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–9 włączają sceny po kolei. 0 wyłącza sceny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–9 ativam cenas em ordem. 0 desativa as cenas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–9 включают сцены по порядку. 0 отключает сцены."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–9 เปิดฉากตามลำดับ 0 ปิดฉาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–9 sahneleri sırayla etkinleştirir. 0 sahneleri kapatır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–9 bật cảnh theo thứ tự. 0 tắt cảnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–9 按顺序启用场景，0 关闭场景。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–9 依序啟用場景，0 關閉場景。"
          }
        }
      }
    },
