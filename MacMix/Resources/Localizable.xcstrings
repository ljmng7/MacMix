    "Your email app doesn't accept attachments from MacMix. Drag the files shown in Finder into the email." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يقبل تطبيق البريد الإلكتروني المرفقات من MacMix. اسحب الملفات المعروضة في Finder إلى الرسالة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine E-Mail-App akzeptiert keine Anhänge von MacMix. Ziehe die im Finder angezeigten Dateien in die E-Mail."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your email app doesn't accept attachments from MacMix. Drag the files shown in Finder into the email."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu app de correo no acepta adjuntos de MacMix. Arrastra al correo los archivos que se muestran en el Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre app de messagerie n’accepte pas les pièces jointes de MacMix. Faites glisser dans l’e-mail les fichiers affichés dans le Finder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका ईमेल ऐप MacMix से अटैचमेंट स्वीकार नहीं करता। Finder में दिखाई गई फ़ाइलों को ईमेल में खींचें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App email Anda tidak menerima lampiran dari MacMix. Seret file yang ditampilkan di Finder ke email."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua app e-mail non accetta allegati da MacMix. Trascina nell’e-mail i file mostrati nel Finder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いのメールAppはMacMixからの添付ファイルを受け付けません。Finderに表示されたファイルをメールにドラッグしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 중인 이메일 앱이 MacMix의 첨부 파일을 받지 않습니다. Finder에 표시된 파일을 이메일로 드래그하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je e-mailapp accepteert geen bijlagen van MacMix. Sleep de bestanden die in de Finder worden getoond naar de e-mail."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja aplikacja poczty nie przyjmuje załączników z MacMix. Przeciągnij do wiadomości pliki pokazane w Finderze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu app de e-mail não aceita anexos do MacMix. Arraste para o e-mail os arquivos mostrados no Finder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше почтовое приложение не принимает вложения от MacMix. Перетащите в письмо файлы, показанные в Finder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปอีเมลของคุณไม่รับไฟล์แนบจาก MacMix ลากไฟล์ที่แสดงใน Finder ไปใส่ในอีเมล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-posta uygulamanız MacMix’ten ek kabul etmiyor. Finder’da gösterilen dosyaları e-postaya sürükleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng email của bạn không nhận tệp đính kèm từ MacMix. Hãy kéo các tệp hiển thị trong Finder vào email."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的邮件应用无法从 MacMix 接收附件。请将访达中显示的文件拖到邮件里。"
