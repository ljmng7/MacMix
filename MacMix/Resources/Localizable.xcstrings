    "This stops the current recording and deletes all logs and saved diagnostic recordings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى إيقاف التسجيل الحالي وحذف جميع السجلات والتسجيلات التشخيصية المحفوظة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird die aktuelle Aufzeichnung gestoppt und alle Protokolle und gesicherten Diagnoseaufzeichnungen werden gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This stops the current recording and deletes all logs and saved diagnostic recordings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detendrá el registro actual y se eliminarán todos los registros y los registros de diagnóstico guardados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement en cours sera arrêté et tous les journaux et enregistrements de diagnostic seront supprimés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे वर्तमान रिकॉर्डिंग रुक जाएगी और सभी लॉग व सहेजी गई डायग्नोस्टिक रिकॉर्डिंग डिलीट हो जाएँगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini menghentikan rekaman saat ini serta menghapus semua log dan rekaman diagnostik yang disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrà interrotta la registrazione in corso ed eliminati tutti i log e le registrazioni diagnostiche salvate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の記録を停止し、すべてのログと保存済みの診断記録を削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 기록이 중지되고 모든 로그와 저장된 진단 기록이 삭제됩니다."
          }
        },
        "nl" : {
