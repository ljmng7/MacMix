    "Custom EQ turns off %@ volume. Turning off Custom EQ restores it automatically." : {
      "comment" : "The placeholder is the localized 200 percent volume level, formatted in code.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُوقف EQ المخصص مستوى الصوت %@ ويعطّل هذا الخيار. ويُستعاد الإعداد تلقائيًا عند إيقاف EQ المخصص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der eigene EQ schaltet %@ Lautstärke aus und deaktiviert die Option. Beim Ausschalten des eigenen EQ wird sie automatisch wiederhergestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom EQ turns off %@ volume. Turning off Custom EQ restores it automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El EQ personalizado desactiva el volumen al %@. Al desactivar el EQ personalizado, se restaura automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’égaliseur personnalisé désactive le volume à %@. Sa désactivation rétablit automatiquement ce réglage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कस्टम EQ, %@ वॉल्यूम को बंद और अक्षम कर देता है। कस्टम EQ बंद करने पर सेटिंग अपने आप बहाल हो जाएगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EQ Kustom menonaktifkan volume %@. Menonaktifkan EQ Kustom akan memulihkan pengaturan tersebut secara otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’EQ personalizzato disattiva il volume al %@. Disattivando l’EQ personalizzato, l’impostazione viene ripristinata automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタムEQを有効にすると、%@の音量がオフになり、使用できなくなります。カスタムEQをオフにすると自動的に元に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 설정 EQ를 켜면 %@ 음량이 꺼지고 비활성화됩니다. 사용자 설정 EQ를 끄면 자동으로 복원됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aangepaste EQ schakelt het volume van %@ uit. Als je aangepaste EQ uitschakelt, wordt de instelling automatisch hersteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Własny EQ wyłącza głośność %@. Po wyłączeniu własnego EQ to ustawienie jest automatycznie przywracane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O EQ personalizado desativa o volume de %@. Ao desativar o EQ personalizado, o ajuste é restaurado automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пользовательский EQ отключает громкость %@. При выключении пользовательского EQ настройка восстанавливается автоматически."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EQ แบบกำหนดเองจะปิดระดับเสียง %@ และทำให้ตัวเลือกนี้ใช้งานไม่ได้ เมื่อปิด EQ แบบกำหนดเอง การตั้งค่าจะคืนค่าโดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel EQ, %@ ses düzeyini kapatır ve devre dışı bırakır. Özel EQ kapatıldığında ayar otomatik olarak geri yüklenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EQ tùy chỉnh tắt và vô hiệu hóa âm lượng %@. Khi tắt EQ tùy chỉnh, cài đặt sẽ tự động được khôi phục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用自定义 EQ 后，将自动关闭并禁用 %@ 音量。关闭自定义 EQ后会自动恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用自訂 EQ 後，將自動關閉並停用 %@ 音量。關閉自訂 EQ 後會自動恢復。"
          }
        }
      }
    },
