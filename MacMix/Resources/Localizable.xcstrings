    "Hold the modifier, a number from 1–9, and a system volume key to control the first nine apps in mixer order." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على مفتاح التعديل ورقم من 1–9 ومفتاح صوت النظام للتحكم في أول تسعة تطبيقات بترتيب المازج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifikatortaste, eine Zahl von 1–9 und eine Systemlautstärketaste gedrückt halten, um die ersten neun Apps in Mixer-Reihenfolge zu steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold the modifier, a number from 1–9, and a system volume key to control the first nine apps in mixer order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el modificador, un número del 1 al 9 y una tecla de volumen del sistema para controlar las primeras nueve apps en el orden del mezclador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez la touche de modification, un chiffre de 1–9 et une touche de volume système pour contrôler les neuf premières apps dans l’ordre du mixeur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिक्सर क्रम के पहले नौ ऐप नियंत्रित करने के लिए मॉडिफ़ायर, 1–9 में से एक अंक और सिस्टम वॉल्यूम कुंजी दबाए रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan tombol pengubah, angka 1–9, dan tombol volume sistem untuk mengontrol sembilan app pertama sesuai urutan mixer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuti il modificatore, un numero da 1 a 9 e un tasto del volume di sistema per controllare le prime nove app nell’ordine del mixer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修飾キー、数字 1–9、システム音量キーを押しながら、ミキサー順の最初の 9 アプリを操作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보조 키, 숫자 1–9 및 시스템 음량 키를 눌러 믹서 순서대로 처음 9개 앱을 제어합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de modificatietoets, een cijfer van 1–9 en een systeemvolumetoets ingedrukt om de eerste negen apps in mixervolgorde te bedienen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj modyfikator, cyfrę 1–9 i klawisz głośności systemu, aby sterować pierwszymi dziewięcioma aplikacjami w kolejności miksera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure o modificador, um número de 1 a 9 e uma tecla de volume do sistema para controlar os primeiros nove apps na ordem do mixer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте модификатор, цифру 1–9 и клавишу системной громкости для управления первыми девятью приложениями по порядку микшера."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กดปุ่มปรับแต่ง ตัวเลข 1–9 และปุ่มระดับเสียงระบบค้างไว้เพื่อควบคุม 9 แอปแรกตามลำดับในมิกเซอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikser sırasındaki ilk dokuz uygulamayı kontrol etmek için değiştirici tuşu, 1–9 arasında bir rakamı ve sistem ses tuşunu basılı tutun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ phím bổ trợ, một số từ 1–9 và phím âm lượng hệ thống để điều khiển chín ứng dụng đầu theo thứ tự bộ trộn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住修饰键、数字 1–9 和系统音量键，按混音列表顺序控制前 9 个 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住修飾鍵、數字 1–9 和系統音量鍵，依混音列表順序控制前 9 個 App。"
          }
        }
      }
    },
