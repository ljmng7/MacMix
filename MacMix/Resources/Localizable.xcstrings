    "Click a scene label to activate its preset.\nClick here to turn scene presets off." : {
      "comment" : "First-scene popover anchored below the default button. Keep the two instruction lines.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على علامة المشهد لتفعيل الإعداد المسبق.\nانقر هنا لإيقاف إعدادات المشاهد المسبقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf eine Szenenbeschriftung, um die Voreinstellung zu aktivieren.\nKlicke hier, um Szenenvoreinstellungen auszuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a scene label to activate its preset.\nClick here to turn scene presets off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en una etiqueta de escena para activar su preajuste.\nHaz clic aquí para desactivar los preajustes de escena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur une étiquette de scène pour activer son préréglage.\nCliquez ici pour désactiver les préréglages de scène."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रीसेट सक्रिय करने के लिए सीन लेबल पर क्लिक करें।\nसीन प्रीसेट बंद करने के लिए यहाँ क्लिक करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik label adegan untuk mengaktifkan presetnya.\nKlik di sini untuk menonaktifkan preset adegan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic sull’etichetta di una scena per attivarne il preset.\nFai clic qui per disattivare i preset delle scene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーンラベルをクリックするとプリセットが有効になります。\nここをクリックするとシーンプリセットが無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장면 레이블을 클릭하면 프리셋이 활성화됩니다.\n여기를 클릭하면 장면 프리셋이 꺼집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op een scènelabel om de voorinstelling te activeren.\nKlik hier om scènevoorinstellingen uit te schakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij etykietę sceny, aby aktywować jej ustawienia.\nKliknij tutaj, aby wyłączyć ustawienia scen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique no rótulo de uma cena para ativar sua predefinição.\nClique aqui para desativar as predefinições de cena."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на метку сцены, чтобы активировать её настройки.\nНажмите здесь, чтобы отключить настройки сцен."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คลิกป้ายชื่อฉากเพื่อเปิดใช้ค่าที่ตั้งไว้\nคลิกที่นี่เพื่อปิดค่าที่ตั้งไว้ของฉาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ön ayarı etkinleştirmek için sahne etiketine tıklayın.\nSahne ön ayarlarını kapatmak için buraya tıklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấp vào nhãn cảnh để kích hoạt cài đặt sẵn.\nNhấp vào đây để tắt cài đặt sẵn của cảnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击场景标签即启用场景预设，\n点击此处关闭场景预设。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點擊場景標籤即可啟用場景預設，\n點擊此處關閉場景預設。"
          }
        }
      }
    },
