    "Logs and diagnostic recordings stay on this Mac for up to 7 days and contain no audio, media titles or license information." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى السجلات والتسجيلات التشخيصية على هذا الـ Mac لمدة تصل إلى 7 أيام، ولا تحتوي على صوت أو عناوين وسائط أو معلومات الترخيص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protokolle und Diagnoseaufzeichnungen bleiben bis zu 7 Tage auf diesem Mac und enthalten weder Audio noch Medientitel oder Lizenzinformationen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logs and diagnostic recordings stay on this Mac for up to 7 days and contain no audio, media titles or license information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros y los registros de diagnóstico se guardan en este Mac hasta 7 días y no contienen audio, títulos multimedia ni información de licencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les journaux et enregistrements de diagnostic restent sur ce Mac jusqu’à 7 jours et ne contiennent ni audio, ni titres de médias, ni informations de licence."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉग और डायग्नोस्टिक रिकॉर्डिंग इस Mac पर अधिकतम 7 दिनों तक रहती हैं और इनमें ऑडियो, मीडिया शीर्षक या लाइसेंस जानकारी नहीं होती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log dan rekaman diagnostik disimpan di Mac ini hingga 7 hari dan tidak berisi audio, judul media, atau informasi lisensi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I log e le registrazioni diagnostiche restano su questo Mac fino a 7 giorni e non contengono audio, titoli multimediali o informazioni sulla licenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログと診断記録はこのMacに最長7日間保存され、音声、メディアのタイトル、ライセンス情報は含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그와 진단 기록은 이 Mac에 최대 7일 동안 보관되며 오디오, 미디어 제목 또는 라이선스 정보는 포함되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logboeken en diagnoseopnamen blijven maximaal 7 dagen op deze Mac en bevatten geen audio, mediatitels of licentiegegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logi i nagrania diagnostyczne pozostają na tym Macu do 7 dni i nie zawierają dźwięku, tytułów multimediów ani informacji o licencji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os registros e as gravações de diagnóstico ficam neste Mac por até 7 dias e não contêm áudio, títulos de mídia nem informações de licença."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Журналы и диагностические записи хранятся на этом Mac до 7 дней и не содержат аудио, названий медиа или сведений о лицензии."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกและการบันทึกการวินิจฉัยจะเก็บไว้ใน Mac เครื่องนี้นานสูงสุด 7 วัน และไม่มีเสียง ชื่อสื่อ หรือข้อมูลใบอนุญาต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlükler ve tanılama kayıtları bu Mac’te en fazla 7 gün kalır; ses, medya başlıkları veya lisans bilgisi içermez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhật ký và bản ghi chẩn đoán được lưu trên máy Mac này tối đa 7 ngày và không chứa âm thanh, tiêu đề phương tiện hay thông tin giấy phép."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日志和诊断记录仅保存在这台 Mac 上，最长 7 天，不含音频内容、媒体标题或许可证信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日誌和診斷記錄僅保存在這台 Mac 上，最長 7 天，不含音訊內容、媒體標題或授權資訊。"
          }
        }
      }
    },
